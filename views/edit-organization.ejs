<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <form
    action="/edit-organization/<%= organization.organization_id %>"
    method="POST"
  >
    <div class="form-group">
      <label for="name">
        Organization Name
      </label>

      <input
        type="text"
        id="name"
        name="name"
        value="<%= organization.organization_name %>"
        maxlength="100"
        required
        oninvalid="this.setCustomValidity('Please fill out this field.')"
        oninput="this.setCustomValidity('')"
      />
    </div>

    <div class="form-group">
      <label for="description">
        Description
      </label>

      <textarea
        id="description"
        name="description"
        maxlength="500"
        required
        oninvalid="this.setCustomValidity('Please fill out this field.')"
        oninput="this.setCustomValidity('')"
      ><%= organization.organization_description %></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">
        Contact Email
      </label>

      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        value="<%= organization.organization_email %>"
        maxlength="100"
        required
        oninvalid="this.setCustomValidity('Please enter a valid email address.')"
        oninput="this.setCustomValidity('')"
      />
    </div>

    <div class="form-actions">
      <button type="submit">
        Update Organization
      </button>

      <a
        href="/organizations/<%= organization.organization_id %>"
      >
        Cancel
      </a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>