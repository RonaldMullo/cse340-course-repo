<%- include('partials/header') %>

<main>
    <h1>Organizations</h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(org => { %>
        <li>
            <img src="<%= org.organization_image %>" alt="<%= org.organization_name %> logo" class="org-logo">
            <a href="/organizations/<%= org.organization_id %>"><strong><%= org.organization_name %></strong></a>: <%= org.organization_email %>
        </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>