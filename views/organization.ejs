<%- include('partials/header') %>

<main>
    <h1><%= organization.organization_name %></h1>
    <img src="<%= organization.organization_image %>" alt="<%= organization.organization_name %> logo" class="org-logo">
    <p>Email: <%= organization.organization_email %></p>
    <p>
  <strong>Description:</strong>
  <%= organization.organization_description %>
</p>

    <h2>Service Projects</h2>
    <% if (projects.length === 0) { %>
        <p>No service projects listed yet for this organization.</p>
    <% } else { %>
<p>
  <a
    class="button-link"
    href="/edit-organization/<%= organization.organization_id %>"
  >
    Edit Organization
  </a>
</p>

        <ul>
            <% projects.forEach(project => { %>
            <li><a href="/projects/<%= project.project_id %>"><%= project.project_name %></a></li>
            <% }) %>
        </ul>
    <% } %>

    <p><a href="/organizations">&laquo; Back to Organizations</a></p>
</main>

<%- include('partials/footer') %>