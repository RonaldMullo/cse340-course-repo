<%- include('partials/header') %>

<main>
  <h1><%= project.project_name %></h1>

  <p><%= project.project_description %></p>

  <p>
    <strong>Location:</strong>
    <%= project.project_location %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= new Date(project.project_date).toLocaleDateString(
      'en-US',
      { timeZone: 'UTC' }
    ) %>
  </p>

  <p>
    <strong>Hosted by:</strong>
    <a href="/organizations/<%= project.organization_id %>">
      <%= project.organization_name %>
    </a>
  </p>

  <% if (categories && categories.length > 0) { %>
  <h2>Categories</h2>

  <div class="category-tags">
    <% categories.forEach((category) => { %>
      <a
        href="/categories/<%= category.category_id %>"
        class="tag"
      >
        <%= category.category_name %>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <p>No categories assigned yet.</p>
<% } %>

<div class="form-actions">
  <a
    class="button-link"
    href="/edit-project/<%= project.project_id %>"
  >
    Edit Project
  </a>

  <a
    class="button-link"
    href="/assign-categories/<%= project.project_id %>"
  >
    Assign Categories
  </a>
</div>

<p>
  <a href="/projects">
    &laquo; Back to Projects
  </a>
</p>