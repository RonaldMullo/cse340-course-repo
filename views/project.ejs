<%- include('partials/header') %>

<main>
    <h1><%= project.project_name %></h1>
    <p><%= project.project_description %></p>
    <p>Date: <%= new Date(project.project_date).toLocaleDateString() %></p>
    <p>Hosted by: <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <% if (categories.length > 0) { %>
        <div class="category-tags">
            <% categories.forEach(category => { %>
            <a href="/categories/<%= category.category_id %>" class="tag"><%= category.category_name %></a>
            <% }) %>
        </div>
    <% } %>

    <p><a href="/projects">&laquo; Back to Projects</a></p>
</main>

<%- include('partials/footer') %>