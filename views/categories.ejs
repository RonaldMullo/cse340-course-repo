<%- include('partials/header') %>

<main>
    <h1>Categories</h1>
    <p>Browse volunteer opportunities by category:</p>
    <ul>
        <% categories.forEach(category => { %>
        <li><a href="/categories/<%= category.category_id %>"><%= category.category_name %></a></li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>