<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <form action="/new-project" method="POST">
    <div class="form-group">
      <label for="title">Project Title</label>

      <input
        type="text"
        id="title"
        name="title"
        value="<%= formData.title %>"
        maxlength="100"
        required
        oninvalid="this.setCustomValidity('Please fill out this field.')"
        oninput="this.setCustomValidity('')"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>

      <textarea
        id="description"
        name="description"
        maxlength="1000"
        required
        oninvalid="this.setCustomValidity('Please fill out this field.')"
        oninput="this.setCustomValidity('')"
      ><%= formData.description %></textarea>
    </div>

    <div class="form-group">
      <label for="location">Location</label>

      <input
        type="text"
        id="location"
        name="location"
        value="<%= formData.location %>"
        maxlength="150"
        required
        oninvalid="this.setCustomValidity('Please fill out this field.')"
        oninput="this.setCustomValidity('')"
      />
    </div>

    <div class="form-group">
      <label for="date">Date</label>

      <input
        type="date"
        id="date"
        name="date"
        value="<%= formData.date %>"
        required
        oninvalid="this.setCustomValidity('Please select a date.')"
        oninput="this.setCustomValidity('')"
      />
    </div>

    <div class="form-group">
      <label for="organizationId">
        Organization
      </label>

      <select
        id="organizationId"
        name="organizationId"
        required
        oninvalid="this.setCustomValidity('Please select an organization.')"
        oninput="this.setCustomValidity('')"
      >
        <option value="">
          Select an organization
        </option>

        <% organizations.forEach((organization) => { %>
          <option
            value="<%= organization.organization_id %>"
            <%= String(formData.organizationId) ===
                String(organization.organization_id)
              ? 'selected'
              : '' %>
          >
            <%= organization.organization_name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit">
        Create Project
      </button>

      <a href="/projects">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>