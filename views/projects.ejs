<%- include('partials/header') %>

<main>
  <h1>Projects</h1>

  <h2>All Service Projects</h2>

  <% if (!projects || projects.length === 0) { %>
    <p>No service projects are currently available.</p>
  <% } else { %>
    <section class="project-list">
      <% projects.forEach((project) => { %>
        <article class="project-card">
          <h2>
            <a href="/projects/<%= project.project_id %>">
              <%= project.project_name %>
            </a>
          </h2>

          <p><%= project.project_description %></p>

          <p>
            <strong>Location:</strong>
            <%= project.project_location %>
          </p>

          <p>
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString(
              'en-US',
              { timeZone: 'UTC' }
            ) %>
          </p>

          <p>
            <strong>Organization:</strong>
            <a href="/organizations/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </p>
        </article>
      <% }) %>
    </section>
  <% } %>
  <p>
  <a class="button-link" href="/new-project">
    Add New Service Project
  </a>
</p>
</main>

<%- include('partials/footer') %>